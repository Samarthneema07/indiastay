# Copy to .env for local/production configuration.
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=*
# Payments are optional. Use "razorpay" only after adding real/test keys.
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo payment is simulated locally. No payment credentials are required.
